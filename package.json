{
  "name": "morada",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "functions:build": "node scripts/build-functions.mjs",
    "aw:config": "node scripts/generate-appwrite-config.mjs",
    "aw:push": "npm run functions:build && appwrite push all --force",
    "aw:pull": "appwrite pull",
    "seed": "node --env-file=.env --import tsx scripts/seed.ts",
    "test:isolation": "node --env-file=.env --import tsx scripts/isolation-test.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.9.0",
    "@tanstack/query-sync-storage-persister": "^5.51.0",
    "@tanstack/react-query": "^5.51.0",
    "@tanstack/react-query-persist-client": "^5.51.0",
    "appwrite": "^26.1.0",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.52.0",
    "react-router-dom": "^6.25.0",
    "recharts": "^2.12.7",
    "rrule": "^2.8.1",
    "zod": "^3.23.8",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/web-push": "^3.6.3",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "appwrite-cli": "^22.6.1",
    "autoprefixer": "^10.4.19",
    "esbuild": "^0.23.0",
    "eslint": "^9.8.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.9",
    "globals": "^15.9.0",
    "jsdom": "^24.1.1",
    "node-appwrite": "^26.2.0",
    "postcss": "^8.4.40",
    "tailwindcss": "^3.4.7",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.0.0",
    "vite": "^5.3.5",
    "vite-plugin-pwa": "^0.20.1",
    "vitest": "^2.0.4",
    "web-push": "^3.6.7"
  }
}
