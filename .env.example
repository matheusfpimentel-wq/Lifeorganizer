# === Frontend (Vite) — seguro para o bundle ===
VITE_APPWRITE_ENDPOINT=            # ex.: https://<region>.cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=
VITE_APPWRITE_DATABASE_ID=morada
VITE_VAPID_PUBLIC_KEY=             # chave pública VAPID (a privada NUNCA vai pro front)
VITE_API_FUNCTION_URL=            # URL pública da function `api` (ex.: https://<id>.<region>.appwrite.run) — feed iCal

# === CLI / scripts / CI — NUNCA entra no bundle do frontend ===
APPWRITE_ENDPOINT=
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=                  # API key server-side (seeds, testes de isolamento, keepalive)

# Keepalive (evita a pausa por inatividade do plano Free — ver npm run keepalive)
# KEEPALIVE_TABLE=                  # opcional: se definido, faz upsert (modo-escrita) em vez de leitura
# KEEPALIVE_READ_TABLE=households   # opcional: tabela lida no ping (padrão: households)

# === Variáveis de ambiente das FUNCTIONS (configurar no Appwrite Console/config) ===
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:seu-email@exemplo.com
